# REWIND — Supabase Configuration
# 1. Go to https://supabase.com → Sign up (free, no card)
# 2. Create a new project
# 3. Go to Project Settings → API
# 4. Copy the "Project URL" and "anon public" key below:

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────
# Server-side secrets — required by the Express API (api/server.js,
# api/routes/*, api/middleware/*). NEVER prefix these with VITE_ or
# they will be bundled into the public client JS. Set real values in
# your host's environment/secrets manager (Railway, Vercel, etc.) —
# this file only documents what exists, it is never loaded as-is.
# ─────────────────────────────────────────────────────────────

SUPABASE_SERVICE_ROLE_KEY=   # server-only — full read/write, bypasses RLS; never expose to the client bundle

# Stripe
VITE_STRIPE_PUBLISHABLE_KEY=   # client-side Stripe.js init (src/components/Shop.jsx, PaymentCard.jsx) — safe to expose, it's the publishable key
STRIPE_SECRET_KEY=   # server-side Stripe API calls (create-payment-intent); checkout returns 400 without it
STRIPE_WEBHOOK_SECRET=   # verifies /api/stripe-webhook signatures via stripe.webhooks.constructEvent

# Admin auth
ADMIN_SECRET_TOKEN=   # long random string; master admin auth secret used to sign/verify admin sessions — rotating this revokes all admin sessions
ADMIN_API_TOKEN=   # legacy alias, still read as a fallback if ADMIN_SECRET_TOKEN is unset — prefer setting ADMIN_SECRET_TOKEN

# Email (Resend)
RESEND_API_KEY=   # transactional email sending — order confirmations, cancellations, abandoned-cart recovery, campaign emails
FROM_EMAIL=   # optional — defaults to "REWIND <orders@rewind-stores.com>"
REPLY_TO=   # optional — defaults to "orders@rewind-stores.com"

# AI (Gemini)
GEMINI_API_KEY=   # used to draft admin order-cancellation emails and audit-log summaries (api/routes/admin-orders.js, admin-audit.js)

# Cron
CRON_SECRET_TOKEN=   # shared x-cron-token secret for /api/cron/* routes (abandoned-cart, chat auto-reply/poll)

# Push notifications
VAPID_PRIVATE_KEY=   # generate with `npx web-push generate-vapid-keys`. Required — push notifications are skipped
                      # entirely if unset (api/push-routes.js fails closed). NOTE: an older hardcoded fallback key
                      # was removed from source but remains in git history — treat it as compromised and never reuse it

# ─────────────────────────────────────────────────────────────
# Platform / build — usually auto-set by the hosting provider or
# test runner; you normally don't need to set these yourself.
# ─────────────────────────────────────────────────────────────
PORT=   # local server port (Railway/Vercel set this automatically)
VERCEL=   # auto-set by Vercel; used to detect a serverless (vs. long-running) deploy
RAILWAY_ENVIRONMENT_NAME=   # auto-set by Railway; used by the /health endpoint for platform detection
TEST_URL=   # Playwright test target URL (tests/, playwright.config.js) — test-only, not read by the app itself
BROWSER=   # Playwright test browser selection — test-only, not read by the app itself
